# ExamOS backend configuration.
# Copy to .env and adjust. All values also work as plain environment variables.

# --- storage ---------------------------------------------------------------
# SQLite (default, zero setup): sqlite:///./var/examos.db
# PostgreSQL (production):       postgresql+psycopg://examos:examos@localhost:5432/examos
EXAMOS_DATABASE_URL=sqlite:///./var/examos.db

# --- model provider (optional) --------------------------------------------
# ExamOS runs fully offline with deterministic heuristics. Configure an
# OpenAI-compatible endpoint to enable LLM-assisted tagging / generation.
EXAMOS_LLM_ENABLED=false
EXAMOS_LLM_BASE_URL=https://api.deepseek.com/v1
EXAMOS_LLM_API_KEY=
EXAMOS_LLM_MODEL=deepseek-chat
EXAMOS_LLM_TIMEOUT=45

# --- study defaults --------------------------------------------------------
EXAMOS_DAILY_MINUTES=240
EXAMOS_TIMEZONE=Asia/Shanghai
EXAMOS_DEFAULT_USER=default
